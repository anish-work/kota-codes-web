# Copy to .env.local and fill in.

# PIN for the host remote (/play/host). Use 6+ digits.
HOST_PIN=

# Your own router's wifi. Shown as a QR code on the big screen so phones can join in one scan.
# Leave the password empty for an open network.
WIFI_SSID=
WIFI_PASSWORD=

# Optional. The address phones open, e.g. http://192.168.1.10:3000/play
# Leave empty and the laptop's own wifi address is found by itself.
PUBLIC_URL=
